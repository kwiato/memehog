# --- Telegram bot -----------------------------------------------------------
# Token from @BotFather. Leave empty to run without the bot (web UI only).
BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to use the bot (get yours from @userinfobot).
# Empty list = nobody can use the bot.
ALLOWED_TELEGRAM_IDS=

# --- API / web ---------------------------------------------------------------
# Bearer token required by /api/v1/* endpoints (used later by the Chrome
# extension and Android app). install.sh generates a random one.
API_TOKEN=change-me

HOST=0.0.0.0
PORT=2137

# --- Storage -----------------------------------------------------------------
# All media, thumbnails and the database live under this directory.
# Inside Docker this is always /data (mapped by docker-compose).
DATA_DIR=data

# --- Downloads ---------------------------------------------------------------
# Optional Netscape-format cookies file for Instagram/TikTok (private or
# rate-limited content). See README.
COOKIES_FILE=

# --- Indexing ---------------------------------------------------------------
# Cron expression for the nightly maintenance (webp/webm transcode + VLM index).
SCAN_CRON=0 3 * * *

# Nightly VLM indexer: OCRs each meme and writes a short description into the
# search index, so memes are findable by the text on them and by what they show.
# Works with ANY OpenAI-compatible vision endpoint. Recommended free option —
# Google Gemini (get a key at https://aistudio.google.com):
#   VLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   VLM_MODEL=gemini-3.5-flash
# Other options: OpenRouter (https://openrouter.ai/api/v1 + a :free vision
# model), Groq, Mistral, a local Ollama (http://host:11434/v1 + e.g. qwen2.5vl).
# Leave VLM_BASE_URL/VLM_MODEL empty to disable indexing.
VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL=

# Language the descriptions are written in (searches match this language).
VLM_LANGUAGE=English

# Requests per minute — keep under your provider's free-tier limit.
VLM_RPM=10

# Max items per indexer run; a large backfill spreads over several runs
# instead of exhausting a daily free-tier quota.
VLM_MAX_PER_RUN=200

# Extra indexer runs between the nightly ones, in minutes (0 = nightly only).
# Frequent runs give models that hit their daily quota a quick retry once it
# resets, and new memes get indexed within the hour.
VLM_INTERVAL_MINUTES=60

# Free API tiers may use your inputs for model training. Spicy memes are
# therefore NOT sent to the VLM unless you opt in.
VLM_INDEX_SPICY=false

# Let the AI indexer also attach tags to memes. It prefers your existing tags
# and invents new ones only when nothing fits; AI tags show dashed in the UI
# and can be removed like any other tag.
VLM_AUTO_TAG=true

LOG_LEVEL=INFO
